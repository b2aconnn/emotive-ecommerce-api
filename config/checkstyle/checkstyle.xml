<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    백엔드 코드 컨벤션 검사 규칙 (docs/convention/backend-convention.md)

    - 포맷(들여쓰기, 공백, 줄바꿈, import 정렬)은 Spotless(palantir-java-format)가 담당한다.
      Checkstyle 은 포매터가 고치지 못하는 네이밍/금지 패턴을 검사한다.
    - main / test 차이는 suppressions.xml 에서 파일 경로 기준으로 관리한다.
    - 불가피한 예외는 @SuppressWarnings("checkstyle:{id}") 로 명시하고 사유를 주석으로 남긴다.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/suppressions.xml"/>
        <property name="optional" value="false"/>
    </module>
    <module name="SuppressWarningsFilter"/>

    <!-- ===================== 4.1 포맷 ===================== -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>
    <module name="NewlineAtEndOfFile"/>
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^(package|import) .*$"/>
    </module>
    <module name="RegexpSingleline">
        <property name="id" value="trailingWhitespace"/>
        <property name="format" value="\s+$"/>
        <property name="message" value="줄 끝 공백은 허용하지 않습니다. (4.1)"/>
    </module>

    <module name="TreeWalker">
        <module name="SuppressWarningsHolder"/>

        <!-- ===================== 4.1 중괄호 ===================== -->
        <module name="NeedBraces"/>
        <module name="LeftCurly"/>
        <module name="RightCurly"/>

        <!-- ===================== 4.2 import ===================== -->
        <module name="AvoidStarImport"/>
        <!-- static import 는 테스트 코드에서만 허용 (suppressions.xml) -->
        <module name="AvoidStaticImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>
        <module name="ImportOrder">
            <property name="groups" value="/^java\./,/^(javax|jakarta)\./,/^org\./,/^com\./"/>
            <property name="ordered" value="true"/>
            <property name="separated" value="true"/>
            <property name="option" value="top"/>
            <property name="sortStaticImportsAlphabetically" value="true"/>
        </module>
        <module name="IllegalImport">
            <property name="illegalPkgs" value="sun, java.util.logging"/>
            <!-- @Data 금지 (4.4), 로거는 @Slf4j 사용 (13) -->
            <property name="illegalClasses" value="lombok.Data, org.slf4j.LoggerFactory"/>
        </module>

        <!-- ===================== 3.1 네이밍 ===================== -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
            <message key="name.invalidPattern" value="패키지명 ''{0}'' 은 소문자로만 작성하고 언더스코어를 쓰지 않습니다. (3.1)"/>
        </module>
        <module name="TypeName"/>
        <module name="MethodName">
            <property name="id" value="mainMethodName"/>
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <!-- 테스트 메서드는 한글, 언더스코어 허용 (15.2) -->
        <module name="MethodName">
            <property name="id" value="testMethodName"/>
            <property name="format" value="^[a-z가-힣][a-zA-Z0-9_가-힣]*$"/>
        </module>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LambdaParameterName"/>
        <module name="CatchParameterName"/>
        <module name="LocalVariableName"/>
        <module name="LocalFinalVariableName"/>
        <module name="PatternVariableName"/>
        <module name="RecordComponentName"/>
        <module name="StaticVariableName"/>
        <module name="ConstantName"/>
        <module name="ClassTypeParameterName"/>
        <module name="MethodTypeParameterName"/>
        <module name="InterfaceTypeParameterName"/>
        <module name="RecordTypeParameterName"/>
        <!-- 약어도 일반 단어처럼: HttpClient (O), HTTPClient (X), userId (O), userID (X) -->
        <module name="AbbreviationAsWordInName">
            <property name="allowedAbbreviationLength" value="0"/>
            <property name="ignoreFinal" value="false"/>
        </module>
        <module name="MatchXpath">
            <property name="id" value="enumConstantName"/>
            <property name="query"
                      value="//ENUM_CONSTANT_DEF/IDENT[not(matches(@text, '^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$'))]"/>
            <message key="matchxpath.match" value="Enum 값은 UPPER_SNAKE_CASE 로 작성합니다. (3.1)"/>
        </module>
        <module name="MatchXpath">
            <property name="id" value="booleanPrefix"/>
            <property name="query" value="//*[self::VARIABLE_DEF or self::PARAMETER_DEF or self::RECORD_COMPONENT_DEF]
                [TYPE/LITERAL_BOOLEAN or TYPE/IDENT[@text='Boolean']]
                [not(MODIFIERS/LITERAL_STATIC and MODIFIERS/FINAL)]
                /IDENT[not(matches(@text, '^(is|has|can)[A-Z0-9]'))]"/>
            <message key="matchxpath.match" value="Boolean 변수는 is / has / can 접두사를 사용합니다. (3.1)"/>
        </module>

        <!-- ===================== 3.2 클래스 접미사 ===================== -->
        <module name="MatchXpath">
            <property name="id" value="controllerSuffix"/>
            <property name="query" value="//CLASS_DEF[MODIFIERS/ANNOTATION/IDENT[@text='RestController' or @text='Controller']]
                /IDENT[not(ends-with(@text, 'Controller'))]"/>
            <message key="matchxpath.match" value="Controller 클래스명은 ''Controller'' 로 끝나야 합니다. (3.2)"/>
        </module>
        <module name="MatchXpath">
            <property name="id" value="configSuffix"/>
            <property name="query" value="//CLASS_DEF[MODIFIERS/ANNOTATION/IDENT[@text='Configuration']]
                /IDENT[not(ends-with(@text, 'Config'))]"/>
            <message key="matchxpath.match" value="설정 클래스명은 ''Config'' 로 끝나야 합니다. (3.2)"/>
        </module>
        <module name="MatchXpath">
            <property name="id" value="jpaRepositorySuffix"/>
            <property name="query" value="//INTERFACE_DEF[EXTENDS_CLAUSE/IDENT[@text='JpaRepository']]
                /IDENT[not(ends-with(@text, 'JpaRepository'))]"/>
            <message key="matchxpath.match" value="Spring Data Repository 는 ''JpaRepository'' 로 끝나야 합니다. (3.2)"/>
        </module>
        <module name="MatchXpath">
            <property name="id" value="exceptionSuffix"/>
            <property name="query" value="//CLASS_DEF[EXTENDS_CLAUSE/IDENT[ends-with(@text, 'Exception')]]
                /IDENT[not(ends-with(@text, 'Exception'))]"/>
            <message key="matchxpath.match" value="예외 클래스명은 ''Exception'' 으로 끝나야 합니다. (3.2)"/>
        </module>

        <!-- ===================== 4.3 선언 순서 ===================== -->
        <!-- 상수 → 필드 → 생성자 → 메서드 까지만 검사 가능 -->
        <module name="DeclarationOrder"/>

        <!-- ===================== 4.4 Lombok ===================== -->
        <module name="MatchXpath">
            <property name="id" value="entityLombok"/>
            <property name="query" value="//CLASS_DEF[MODIFIERS/ANNOTATION/IDENT[@text='Entity']]
                    /MODIFIERS/ANNOTATION/IDENT[@text='Setter' or @text='ToString' or @text='EqualsAndHashCode']
                | //CLASS_DEF[MODIFIERS/ANNOTATION/IDENT[@text='Entity']]
                    /OBJBLOCK/VARIABLE_DEF/MODIFIERS/ANNOTATION/IDENT[@text='Setter']"/>
            <message key="matchxpath.match"
                     value="엔티티에는 @Setter / @ToString / @EqualsAndHashCode 를 사용하지 않습니다. (4.4)"/>
        </module>
        <module name="MatchXpath">
            <property name="id" value="entityNoArgsConstructor"/>
            <property name="query" value="//CLASS_DEF[MODIFIERS/ANNOTATION/IDENT[@text='Entity']]
                [not(MODIFIERS/ANNOTATION[IDENT[@text='NoArgsConstructor']]//IDENT[@text='PROTECTED'])]
                [not(OBJBLOCK/CTOR_DEF[MODIFIERS/LITERAL_PROTECTED][not(PARAMETERS/PARAMETER_DEF)])]
                /IDENT"/>
            <message key="matchxpath.match"
                     value="엔티티에는 @NoArgsConstructor(access = AccessLevel.PROTECTED) 가 필요합니다. (4.4)"/>
        </module>
        <module name="MatchXpath">
            <property name="id" value="allArgsConstructor"/>
            <property name="severity" value="warning"/>
            <property name="query" value="//ANNOTATION/IDENT[@text='AllArgsConstructor']"/>
            <message key="matchxpath.match" value="@AllArgsConstructor 사용을 지양합니다. 필드 순서 변경 시 버그 위험이 있습니다. (4.4)"/>
        </module>

        <!-- ===================== 4.5 기타 ===================== -->
        <module name="MatchXpath">
            <property name="id" value="fieldInjection"/>
            <property name="query" value="//OBJBLOCK/*[self::VARIABLE_DEF or self::METHOD_DEF]
                /MODIFIERS/ANNOTATION/IDENT[@text='Autowired']"/>
            <message key="matchxpath.match" value="@Autowired 필드/세터 주입 대신 생성자 주입을 사용합니다. (4.5)"/>
        </module>
        <module name="MatchXpath">
            <property name="id" value="optionalFieldOrParameter"/>
            <property name="query" value="//OBJBLOCK/VARIABLE_DEF/TYPE/IDENT[@text='Optional']
                | //PARAMETER_DEF/TYPE/IDENT[@text='Optional']
                | //RECORD_COMPONENT_DEF/TYPE/IDENT[@text='Optional']"/>
            <message key="matchxpath.match" value="Optional 을 필드나 파라미터로 사용하지 않습니다. (4.5)"/>
        </module>
        <module name="MatchXpath">
            <property name="id" value="returnNull"/>
            <property name="query" value="//LITERAL_RETURN[EXPR/LITERAL_NULL]"/>
            <message key="matchxpath.match" value="null 대신 Optional 또는 빈 컬렉션을 반환합니다. (4.5)"/>
        </module>
        <module name="MagicNumber">
            <property name="ignoreHashCodeMethod" value="true"/>
            <property name="ignoreAnnotation" value="true"/>
        </module>
        <module name="MatchXpath">
            <property name="id" value="dtoRecord"/>
            <property name="severity" value="warning"/>
            <property name="query" value="//CLASS_DEF/IDENT[matches(@text, '(Request|Response|Command|Result)$')]"/>
            <message key="matchxpath.match" value="요청/응답/내부 전달 DTO 는 가능한 한 record 로 작성합니다. (4.5)"/>
        </module>
        <module name="TodoComment">
            <property name="format" value="TODO(?!\([^,()]+, #\d+\): )"/>
            <message key="todo.match" value="TODO 에는 담당자와 이슈 번호를 기재합니다. 예) // TODO(할로우, #123): 설명 (4.5)"/>
        </module>

        <!-- ===================== 7.4 예외 처리 ===================== -->
        <module name="EmptyCatchBlock">
            <!-- 주석만 있는 catch 블록도 예외를 삼키는 것으로 본다 -->
            <property name="commentFormat" value="(?!)"/>
        </module>

        <!-- ===================== 10 JPA ===================== -->
        <module name="MatchXpath">
            <property name="id" value="enumeratedString"/>
            <property name="query" value="//ANNOTATION[IDENT[@text='Enumerated']][not(.//IDENT[@text='STRING'])]"/>
            <message key="matchxpath.match" value="@Enumerated(EnumType.STRING) 을 사용합니다. ORDINAL 금지. (10)"/>
        </module>
        <module name="MatchXpath">
            <property name="id" value="lazyFetch"/>
            <property name="query" value="//ANNOTATION[IDENT[@text='ManyToOne' or @text='OneToOne']][not(.//IDENT[@text='LAZY'])]"/>
            <message key="matchxpath.match" value="@ManyToOne / @OneToOne 에는 fetch = FetchType.LAZY 를 명시합니다. (10)"/>
        </module>
        <module name="MatchXpath">
            <property name="id" value="modifyingClearAutomatically"/>
            <property name="query" value="//ANNOTATION[IDENT[@text='Modifying']]
                [not(ANNOTATION_MEMBER_VALUE_PAIR[IDENT[@text='clearAutomatically']]//LITERAL_TRUE)]"/>
            <message key="matchxpath.match" value="벌크 쿼리는 @Modifying(clearAutomatically = true) 로 영속성 컨텍스트를 정리합니다. (10)"/>
        </module>

        <!-- ===================== 13 로깅 ===================== -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="systemOut"/>
            <property name="format" value="System\.(out|err)\.|\.printStackTrace\(\)"/>
            <property name="ignoreComments" value="true"/>
            <property name="message" value="System.out / printStackTrace() 대신 로거(@Slf4j)를 사용합니다. (13)"/>
        </module>
        <module name="MatchXpath">
            <property name="id" value="logStringConcat"/>
            <property name="query" value="//METHOD_CALL
                [DOT[IDENT[1][@text='log'] and IDENT[2][matches(@text, '^(trace|debug|info|warn|error)$')]]]
                /ELIST/EXPR[1][PLUS]"/>
            <message key="matchxpath.match" value="로그 메시지는 문자열 연결 대신 '{}' 플레이스홀더를 사용합니다. (13)"/>
        </module>
        <module name="MatchXpath">
            <property name="id" value="logInLoop"/>
            <property name="query" value="//*[self::LITERAL_FOR or self::LITERAL_WHILE or self::LITERAL_DO]
                //METHOD_CALL/DOT[IDENT[1][@text='log'] and IDENT[2][matches(@text, '^(info|warn|error)$')]]"/>
            <message key="matchxpath.match" value="반복문 내부에서 INFO 이상 로그를 남기지 않습니다. (13)"/>
        </module>

        <!-- ===================== 14 설정 ===================== -->
        <module name="MatchXpath">
            <property name="id" value="configurationPropertiesRecord"/>
            <property name="query" value="//CLASS_DEF[MODIFIERS/ANNOTATION/IDENT[@text='ConfigurationProperties']]/IDENT"/>
            <message key="matchxpath.match" value="@ConfigurationProperties 는 record 로 바인딩합니다. (14)"/>
        </module>
        <module name="MatchXpath">
            <property name="id" value="valueAnnotation"/>
            <property name="severity" value="warning"/>
            <!-- 인자가 있는 @Value(...) 만 Spring @Value 로 본다 (Lombok @Value 제외) -->
            <property name="query" value="//ANNOTATION[IDENT[@text='Value']][EXPR]"/>
            <message key="matchxpath.match" value="@Value 대신 @ConfigurationProperties + record 사용을 권장합니다. (14)"/>
        </module>
    </module>
</module>
